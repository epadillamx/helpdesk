# =========================================================================
# Frappe Helpdesk - Variables de entorno para producción
# Copia este archivo a `.env` y completa los valores reales.
# =========================================================================

# ----- Build args -----
# Nota: el código de Helpdesk se toma del checkout LOCAL del repo (no se clona
# desde GitHub). Por eso aquí ya no hay HELPDESK_BRANCH: lo que se construya
# es lo que esté actualmente en el árbol de trabajo.
FRAPPE_BRANCH=version-15

# ----- Sitio -----
SITE_NAME=developticket.local
ADMIN_PASSWORD=apilynk25%
HTTP_PORT=80
# ----- Base de datos -----
# Por defecto usa MariaDB local (servicio `mariadb` del compose). Para usar
# Postgres externo cambia DB_TYPE=postgres y apunta DB_HOST a tu RDS.
DB_TYPE=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=helpdesk
# DB_USER y DB_PASSWORD: usuario aplicativo del sitio. Con MariaDB Frappe los
# crea automáticamente la primera vez (usa el root de abajo para conectarse).
# Con Postgres externo deben existir de antemano.
DB_USER=helpdesk
DB_PASSWORD=apilynk90%

# Credenciales root del motor — solo se usan en `bench new-site` para crear
# el usuario aplicativo. Con MariaDB local en compose, este es además el
# password del contenedor. Con Postgres apunta al superuser de tu server.
DB_ROOT_USER=root
DB_ROOT_PASSWORD=apilynk90%



# ----- Redis (resueltos por nombre de servicio en compose) -----
REDIS_CACHE=redis://redis-cache:6379
REDIS_QUEUE=redis://redis-queue:6379
REDIS_SOCKETIO=redis://redis-queue:6379

# ----- AWS (perfil por defecto) -----
# Las credenciales AWS (S3, etc.) se toman del perfil configurado en
# ~/.aws/credentials del host. El directorio se monta en los contenedores
# en modo solo lectura. Solo necesitas indicar el perfil y la región.
AWS_PROFILE=mut-prod-migration
AWS_REGION=us-east-1

# ----- Almacenamiento S3 (archivos adjuntos / backups) -----
# Para almacenamiento de archivos se requiere instalar la app
# `frappe_s3_attachment` (ver README.md).
# Las credenciales (access key/secret) NO se definen aquí: se resuelven
# automáticamente desde el perfil AWS (AWS_PROFILE) montado en el contenedor.
S3_ENDPOINT_URL=https://s3.amazonaws.com
S3_REGION=us-east-1
# Bucket: arn:aws:s3:::529928147458-frappe-heldesk-prod
S3_BUCKET=529928147458-frappe-heldesk-prod
S3_FOLDER_NAME=helpdesk
S3_SIGNATURE_VERSION=s3v4
# Para almacenamiento compatible (MinIO, DigitalOcean Spaces, Wasabi):
#   - Define S3_ENDPOINT_URL al endpoint del proveedor
#   - Mantén S3_REGION según el proveedor
S3_USE_PATH_STYLE=0

# ----- Email (AWS SES vía SMTP) -----
# Las credenciales SMTP de SES son distintas a las de AWS API. Se generan
# al crear el usuario IAM para SES y vienen en el CSV de descarga.
SES_SMTP_ENDPOINT=email-smtp.us-east-1.amazonaws.com
SES_SMTP_PORT=587
SES_IAM_USER_NAME=ses-smtp-user.20260504-193508
SES_SMTP_USER=AKIAXWYRN2IBDIJWSUBO
SES_SMTP_PASSWORD=BAjsXO7IOyVsLyimDJnQVg12CrVcykb+4mfFy3MqVMWP
AUTO_EMAIL_ID=helpdesk@app.mut.cl
USE_TLS=1

# ----- Misc -----
DEVELOPER_MODE=0
ENCRYPTION_KEY=
